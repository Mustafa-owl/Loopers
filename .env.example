# Copy this file to .env and fill in what you need. Everything is optional
# on a laptop; on a live server set at least NODE_ENV, PUBLIC_URL and VAPID_SUBJECT.

# production turns on secure cookies and HSTS, and stops `npm run seed`
# NODE_ENV=production

# Where the app listens. Behind nginx keep 127.0.0.1.
PORT=8080
HOST=127.0.0.1

# The address people type, without a slash at the end
PUBLIC_URL=
# e.g. PUBLIC_URL=https://erbil-utilities.example (leave it empty on a laptop)

# How many proxies sit in front of the app: 0 on a laptop, 1 behind nginx
TRUST_PROXY=0

# Where the database, photos and backups live (relative to this folder)
DATA_DIR=data

# Made automatically on first start and kept in the database. Only set it
# if you want to manage it yourself. Changing it resets everyone's limits.
SECRET_KEY=

# Alerts on residents' phones. Leave the keys empty and they're made on
# first start. The subject must be an address you read.
VAPID_SUBJECT=mailto:team@erbil-utilities.example
# Alerts only go to the browsers' own push services (Google, Mozilla, Apple,
# Microsoft). Add a host here, comma-separated, only if a new browser needs it.
# PUSH_HOSTS=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# The first admin account, made only when there are no accounts yet.
# Leave the password empty and a temporary one is printed in the log.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# How long a team sign-in lasts
SESSION_HOURS=12

# Reading Rudaw, Kurdistan24 and the other news sites every 30 minutes. "off" stops it.
NEWS_FEED=on

# Alerts by text message or WhatsApp (optional; off when empty).
#   webhook: we POST { "to": "+9647…", "channel": "sms"|"whatsapp", "text": "…" }
#            to SMS_WEBHOOK_URL with "Authorization: Bearer SMS_WEBHOOK_TOKEN".
#            Works with any local SMS gateway. List the channels it can send.
#   twilio:  set the account, the token and one or both senders.
SMS_PROVIDER=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
SMS_WEBHOOK_CHANNELS=sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=

# Limits per internet address, per hour. Mobile networks put many phones
# behind one address, so on a citywide evening the defaults can turn real
# people away. Raise them if residents see "too many" while reporting.
# REPORTS_PER_ADDRESS_HOUR=80
# TAPS_PER_ADDRESS_HOUR=600

# Shown on the privacy page as the way to reach whoever runs the site.
# Leave empty and the page points people to the team chat instead.
# CONTACT_EMAIL=privacy@your-domain
# OPERATOR_NAME=Who runs this site (a person, office or organisation)
